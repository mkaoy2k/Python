# Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not commit real keys, tokens, or passwords.

# Logging level: DEBUG or INFO
LOGGING=DEBUG

# Gmail. Used by emailOnQuake.py, emailPublisher.py, emailSender.py,
# smsOnQuake.py, and smsViaSMTP.py.
# Sending through Gmail requires 2-step verification and an app password.
EMAIL_SENDER=your-email-sender
EMAIL_PASSWORD=your-email-password

# emailSendAttach.py and emailSendHTML.py read PASSWORD.
PASSWORD=your-email-password

# sqlite3 database used by qt5sql.py
DB_PATH=sample/users.db
DB_TABLE=users

# PostgreSQL database used by perfDB.py
DB_NAME=test
DB_USER=postgres
DB_PW=your-db-password

# qrCodeGen.py
QR_URL=https://github.com/mkaoy2k/Kids-Lets-Play-Python
QR_FILE=sample/qrCode.png

# quake.py — Taiwan CWA open data. Put your own key in the Authorization query.
# https://opendata.cwa.gov.tw/
QUAKE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore/E-A0015-001?Authorization=your-cwa-api-key
QUAKE_MAGNITUDE=4.0

# smsViaHTTP.py, smsViaSMTP.py, smsOnQuake.py
SMS_URL=https://textbelt.com/text
SMS_MOBILE_NUMBER=your-mobile-number
SMS_GATEWAY=@txt.att.net
SMS_SUBJECT=your-sms-subject
SMS_MESSAGE=your-sms-message
